server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Docker's embedded DNS; lets nginx start even if the API container is not resolvable yet.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $backend "${BACKEND_URL}";

  # API, health and mock supplier endpoints are proxied to the backend (same origin, no CORS needed).
  location ~ ^/(api|health|supplier[A-Za-z0-9]+)(/|$) {
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 35s;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri /index.html;
  }
}
