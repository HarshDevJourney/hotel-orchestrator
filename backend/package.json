{
  "name": "hotel-offer-orchestrator",
  "version": "2.0.0",
  "description": "Aggregates hotel offers from multiple suppliers, keeps the cheapest per hotel, orchestrated with Temporal and filtered in Redis. SOLID, ports-and-adapters design.",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node dist/main/server.js",
    "start:worker": "node dist/main/worker.js",
    "dev:api": "tsx watch src/main/server.ts",
    "dev:worker": "tsx watch src/main/worker.ts",
    "test": "LOG_LEVEL=silent tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.6",
    "@temporalio/client": "^1.11.6",
    "@temporalio/common": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "ioredis-mock": "^8.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
