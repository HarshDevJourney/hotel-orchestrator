PORT=3000
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
# Comma separated supplier ids. One gateway + one health indicator is created per id.
SUPPLIERS=A,B
# Base URL the worker and health check use to reach the suppliers (mocks live inside the API)
SUPPLIER_BASE_URL=http://localhost:3000
SUPPLIER_TIMEOUT_MS=3000
# Start a mock supplier in "down" state (can also be toggled at runtime via PUT /supplier<ID>/status)
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false
